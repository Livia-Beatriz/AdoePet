<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AdotePet"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#247747"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Formulário de pré-adoção"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preencha seus dados para demonstrar interesse em adotar."
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome completo"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite seu nome completo"
            android:inputType="textPersonName"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E-mail"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="seuemail@exemplo.com"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telefone"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/edtTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="(00) 00000-0000"
            android:inputType="phone"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de moradia"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"/>

        <RadioGroup
            android:id="@+id/rgMoradia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/rbCasa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Casa"/>

            <RadioButton
                android:id="@+id/rbApartamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apartamento"/>

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Por que deseja adotar?"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/edtMotivo"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Conte um pouco sobre sua motivação..."
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:layout_marginTop="4dp"/>

        <CheckBox
            android:id="@+id/chkResponsabilidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estou ciente de que adotar um animal exige responsabilidade e cuidados."
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnEnviarPreAdocao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar interesse"
            android:textAllCaps="false"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>