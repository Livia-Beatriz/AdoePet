<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="AdoPet"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="145dp"
            android:layout_height="300px"
            android:src="@drawable/foto_adoPet" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encontre seu novo melhor amigo!"
            android:textColor="#555555"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <!-- Animal 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#F5F5F5">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto do cachorro Luna" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luna"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 anos • Porte médio"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnLuna"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver detalhes"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Animal 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#F5F5F5">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto do cachorro Thor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thor"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 ano • Porte grande"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnThor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver detalhes"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Animal 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#F5F5F5">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto da gata Mel" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mel"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 meses • Porte pequeno"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnMel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver detalhes"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Animal 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="#F5F5F5">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto do cachorro Bob" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bob"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 anos • Porte médio"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnBob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ver detalhes"
                    android:textAllCaps="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </GridLayout>

    </LinearLayout>

</ScrollView>