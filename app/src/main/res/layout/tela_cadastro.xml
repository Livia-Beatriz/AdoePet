<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:layout_width="500px"
            android:layout_height="500px"
            android:src="@drawable/foto_adoPet" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crie sua conta"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastre-se para começar sua jornada de adoção."
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome completo"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/edtCadastroNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite seu nome completo"
            android:inputType="textPersonName"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="14dp"/>

        <EditText
            android:id="@+id/edtCadastroEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="seuemail@exemplo.com"
            android:inputType="textEmailAddress"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="14dp"/>

        <EditText
            android:id="@+id/edtCadastroTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="(00) 00000-0000"
            android:inputType="phone"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senha"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="14dp"/>

        <EditText
            android:id="@+id/edtCadastroSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Crie uma senha"
            android:inputType="textPassword"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar senha"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="14dp"/>

        <EditText
            android:id="@+id/edtConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite a senha novamente"
            android:inputType="textPassword"
            android:minHeight="52dp"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btnCriarConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Criar conta"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/txtJaTenhoConta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Já tem uma conta? Entrar"
            android:textSize="15sp"
            android:textColor="#247747"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>

</ScrollView>